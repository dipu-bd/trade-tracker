<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ subject }}</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#1f2933;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:680px;background:#ffffff;border-radius:10px;border:1px solid #e4e7eb;overflow:hidden;">
            <tr>
              <td style="padding:20px 24px;background:#1f2933;color:#ffffff;">
                <div style="font-size:12px;letter-spacing:.12em;text-transform:uppercase;opacity:.7;">MarketBot</div>
                <div style="font-size:20px;font-weight:600;margin-top:4px;">{% block header %}{{ subject }}{% endblock %}</div>
                {% block subheader %}{% endblock %}
              </td>
            </tr>
            <tr>
              <td style="padding:24px;">
                {% block content %}{% endblock %}
              </td>
            </tr>
            <tr>
              <td style="padding:16px 24px;background:#f9fafb;border-top:1px solid #e4e7eb;font-size:12px;color:#7b8794;">
                Paper trading — no real orders are placed. Figures are simulated
                fills at scan-time prices including modelled slippage and fees.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
