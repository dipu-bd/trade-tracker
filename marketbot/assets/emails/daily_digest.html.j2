{% extends "layout.html.j2" %}

{% block header %}{{ portfolio.name }} — daily digest{% endblock %}

{% block subheader %}
<div style="font-size:13px;opacity:.75;margin-top:6px;">
  {{ as_of }} &middot; {{ regime|capitalize }} regime
</div>
{% endblock %}

{% block content %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:22px;">
  <tr>
    <td style="padding:14px;background:#f9fafb;border:1px solid #e4e7eb;border-radius:8px;" align="center">
      <div style="font-size:12px;color:#7b8794;">Equity</div>
      <div style="font-size:22px;font-weight:600;">{{ equity|money }}</div>
    </td>
    <td width="10"></td>
    <td style="padding:14px;background:#f9fafb;border:1px solid #e4e7eb;border-radius:8px;" align="center">
      <div style="font-size:12px;color:#7b8794;">Since inception</div>
      <div style="font-size:22px;font-weight:600;color:{{ '#e12d39' if total_return < 0 else '#0f8554' }};">
        {{ total_return|signed }}%
      </div>
    </td>
    <td width="10"></td>
    <td style="padding:14px;background:#f9fafb;border:1px solid #e4e7eb;border-radius:8px;" align="center">
      <div style="font-size:12px;color:#7b8794;">Day</div>
      <div style="font-size:22px;font-weight:600;color:{{ '#e12d39' if day_return < 0 else '#0f8554' }};">
        {{ day_return|signed }}%
      </div>
    </td>
  </tr>
</table>

<p style="font-size:13px;color:#52606d;margin:0 0 18px;">
  Original investment {{ portfolio.initial_capital|money }} &middot;
  cash {{ cash|money }} &middot;
  realised {{ realized_pnl|signed_money }} &middot;
  unrealised {{ unrealized_pnl|signed_money }}
  {% if drawdown_pct %}&middot; drawdown {{ drawdown_pct|round(1) }}%{% endif %}
</p>

{% if positions %}
<h3 style="font-size:14px;text-transform:uppercase;letter-spacing:.08em;color:#7b8794;margin:0 0 10px;">Open positions</h3>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:13px;">
  <tr style="background:#f9fafb;color:#7b8794;text-align:left;">
    <th style="padding:8px;border-bottom:1px solid #e4e7eb;">Symbol</th>
    <th style="padding:8px;border-bottom:1px solid #e4e7eb;">Qty</th>
    <th style="padding:8px;border-bottom:1px solid #e4e7eb;">Entry</th>
    <th style="padding:8px;border-bottom:1px solid #e4e7eb;">Last</th>
    <th style="padding:8px;border-bottom:1px solid #e4e7eb;">Stop</th>
    <th style="padding:8px;border-bottom:1px solid #e4e7eb;">Open P&amp;L</th>
    <th style="padding:8px;border-bottom:1px solid #e4e7eb;">Held</th>
  </tr>
  {% for p in positions %}
  <tr>
    <td style="padding:8px;border-bottom:1px solid #f0f2f5;"><strong>{{ p.symbol }}</strong></td>
    <td style="padding:8px;border-bottom:1px solid #f0f2f5;">{{ p.qty|qty }}</td>
    <td style="padding:8px;border-bottom:1px solid #f0f2f5;">{{ p.avg_entry|money }}</td>
    <td style="padding:8px;border-bottom:1px solid #f0f2f5;">{{ p.price|money }}</td>
    <td style="padding:8px;border-bottom:1px solid #f0f2f5;color:#e12d39;">{{ p.stop_price|money }}</td>
    <td style="padding:8px;border-bottom:1px solid #f0f2f5;color:{{ '#e12d39' if p.unrealized < 0 else '#0f8554' }};">
      {{ p.unrealized|signed_money }} ({{ p.r_multiple|signed }}R)
    </td>
    <td style="padding:8px;border-bottom:1px solid #f0f2f5;color:#7b8794;">{{ p.held_days }}d</td>
  </tr>
  {% endfor %}
</table>
{% else %}
<p style="font-size:13px;color:#7b8794;">No open positions — fully in cash.</p>
{% endif %}
{% endblock %}
