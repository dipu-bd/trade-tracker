# Required. At least 32 characters. Wraps every stored provider/LLM credential —
# changing it without rotating makes existing credentials undecryptable.
TRADEBOT_SECRET_KEY=

TRADEBOT_ENV=dev
TRADEBOT_DEBUG=false

# sqlite+aiosqlite:///./tradebot.db for local dev
TRADEBOT_DATABASE_URL=postgresql+asyncpg://tradebot:tradebot@localhost:5432/tradebot
TRADEBOT_DATABASE_ECHO=false

TRADEBOT_ACCESS_TOKEN_TTL_SECONDS=900
TRADEBOT_REFRESH_TOKEN_TTL_SECONDS=2592000
TRADEBOT_COOKIE_SECURE=true
TRADEBOT_COOKIE_DOMAIN=

# Comma separated. Leave empty when the API serves the built frontend itself.
TRADEBOT_CORS_ORIGINS=http://localhost:5173

TRADEBOT_LOG_LEVEL=INFO
TRADEBOT_LOG_JSON=true

# docker compose only
POSTGRES_PASSWORD=tradebot
TRADEBOT_PORT=8000
