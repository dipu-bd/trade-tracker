# Server
SERVER_API_TOKEN=

# Gold API
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=
GOLDAPI_TOKEN=
METALPRICE_API_TOKEN=

# Database
MARKETBOT_DB_URL=sqlite:///./marketbot.db

# Market data
FMP_API_KEY=
FMP_DAILY_REQUEST_BUDGET=240
CRYPTO_QUOTE_CURRENCY=USD
UNIVERSE_MAX_SYMBOLS=140

# Mail (Proton Bridge listens on 127.0.0.1:1025 with a self-signed cert)
SMTP_ENABLED=false
SMTP_SERVER=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_STARTTLS=true
SMTP_TLS_VERIFY=false

# Notifications
NOTIFY_MODE=per_run
NOTIFY_EMAIL=

# Scheduler (UTC cron expressions)
SCHEDULER_ENABLED=true
SCAN_CRON_PREOPEN=15 13 * * 1-5
SCAN_CRON_MAIN=45 19 * * 1-5
SCAN_CRON_CRYPTO=0 */4 * * *
DIGEST_CRON=30 21 * * *

# LLM advisor: off | annotate | veto
LLM_ADVISOR_MODE=off
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT=60
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
